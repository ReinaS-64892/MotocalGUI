# Packaging for MotocalGUI, a hard fork of SpaceCal for Monado.
pkgname=motocalgui-git
pkgver=r10.5cf90d9
pkgrel=1
pkgdesc="GTK4 frontend for libmotoc (Monado/WiVRn calibration) (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/ReinaS-64892/MotocalGUI"
license=('GPL-3.0-only')
depends=('gtk4' 'libadwaita' 'openxr' 'monado')
makedepends=('cargo' 'git')
optdepends=('libcanberra: audio feedback during calibration')
provides=('motocalgui')
conflicts=('motocalgui')
source=("motocalgui::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname%-git}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${pkgname%-git}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${pkgname%-git}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "${pkgname%-git}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --lib --frozen
}

package() {
    cd "${pkgname%-git}"
    make DESTDIR="$pkgdir" PREFIX=/usr install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname%-git}/LICENSE"
}
